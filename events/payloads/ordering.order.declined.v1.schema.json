{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/ordering.order.declined.v1.schema.json",
  "title": "OrderingOrderDeclinedPayload",
  "description": "Payload of `ordering.order.declined` version 1. A placed order was declined: by the store with a reason, by Mission Control, or by the platform when nobody answered in time (`not_answered`) or the card could not be charged (`payment_failed`). Every hold is released and a payment taken at checkout refunded. Consumers: notifications (the customer, whether they were charged), payments, the ledger. The envelope's `partner_id` is the store's Partner and its `correlation_id` follows the order. Read the order at `GET /v1/platform/orders/{order_id}`, `GET /v1/customer/orders/{order_id}` or the store's route. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "order_id",
    "number",
    "location_id",
    "partner_id",
    "customer_id",
    "status",
    "previous_status",
    "version",
    "fulfilment",
    "currency",
    "at",
    "by",
    "reason",
    "released_amount",
    "refunded_amount",
    "sold_out_line_ids"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid",
      "description": "The order.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01"
      ]
    },
    "number": {
      "type": "string",
      "description": "The order's number, as said aloud.",
      "examples": [
        "AB0042"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer (a user id); fetch personal data from the API when it is needed.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "paying",
        "placed",
        "accepted",
        "ready",
        "on_its_way",
        "completed",
        "undelivered",
        "declined",
        "cancelled",
        "expired"
      ],
      "description": "The status after the change.",
      "examples": [
        "placed"
      ]
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "paying",
        "placed",
        "accepted",
        "ready",
        "on_its_way",
        "completed",
        "undelivered",
        "declined",
        "cancelled",
        "expired",
        null
      ],
      "description": "The status before; `null` for a first status.",
      "examples": [
        "paying"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "The order's version after the change; it only rises, and signals carry it.",
      "examples": [
        2
      ]
    },
    "fulfilment": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "description": "Delivery or pickup.",
      "examples": [
        "delivery"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "The currency of every amount, in its minor unit.",
      "examples": [
        "INR"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-10-16T13:00:00Z"
      ]
    },
    "by": {
      "type": "string",
      "enum": [
        "customer",
        "staff",
        "platform",
        "system"
      ],
      "description": "Who made the move.",
      "examples": [
        "staff"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "out_of_stock",
        "too_busy",
        "closing",
        "customer_asked",
        "other",
        "not_answered",
        "payment_failed"
      ],
      "description": "Why.",
      "examples": [
        "too_busy"
      ]
    },
    "released_amount": {
      "type": "integer",
      "description": "What was held and let go.",
      "examples": [
        0
      ]
    },
    "refunded_amount": {
      "type": "integer",
      "description": "What was taken and goes back.",
      "examples": [
        79800
      ]
    },
    "sold_out_line_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "The lines the store declined for want of, their variants marked sold out for today; empty when none was named.",
      "examples": [
        [
          "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b12"
        ]
      ]
    }
  }
}
