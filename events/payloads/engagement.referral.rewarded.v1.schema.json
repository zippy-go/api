{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/engagement.referral.rewarded.v1.schema.json",
  "title": "EngagementReferralRewardedPayload",
  "description": "Payload of `engagement.referral.rewarded` version 1: a referred friend's first order completed and the referrer was credited. The envelope's `partner_id` is `null`. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "properties": {
    "referral_id": {
      "type": "string",
      "format": "uuid",
      "description": "The referral.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e6101"
      ]
    },
    "referrer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The referrer (a user id).",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7001"
      ]
    },
    "referred_id": {
      "type": "string",
      "format": "uuid",
      "description": "The friend (a user id).",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7002"
      ]
    },
    "order_id": {
      "type": "string",
      "format": "uuid",
      "description": "The friend's first order.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01"
      ]
    },
    "grant_id": {
      "type": "string",
      "format": "uuid",
      "description": "The grant of credit.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e6001"
      ]
    },
    "amount": {
      "$ref": "#/$defs/money",
      "description": "The credit."
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the platform recorded it.",
      "examples": [
        "2026-11-02T09:10:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
