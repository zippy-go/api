{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payments.mandate.debit_failed.v1.schema.json",
  "title": "PaymentsMandateDebitFailedPayload",
  "description": "Payload of `payments.mandate.debit_failed` version 1. The bank refused a delivery day's debit: tried once more at 15:00 after the first, and after the second the cutoff takes the Wallet or skips the day. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "mandate_id",
    "debit_id",
    "customer_id",
    "subscription_id",
    "date",
    "amount",
    "attempt",
    "reason",
    "final",
    "at"
  ],
  "properties": {
    "mandate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The mandate.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7601"
      ]
    },
    "debit_id": {
      "type": "string",
      "format": "uuid",
      "description": "The delivery day's debit.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7701"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "subscription_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The subscription it pays.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The delivery day it was to pay for.",
      "examples": [
        "2026-11-06"
      ]
    },
    "amount": {
      "$ref": "#/$defs/money",
      "description": "What it asked for."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "1 at 09:00 the day before, 2 at 15:00.",
      "examples": [
        2
      ]
    },
    "reason": {
      "type": "string",
      "description": "Why the bank refused it, in the provider's words.",
      "examples": [
        "The bank refused the debit"
      ]
    },
    "final": {
      "type": "boolean",
      "description": "No try is left: the cutoff takes the Wallet or skips the day.",
      "examples": [
        true
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-05T09:30:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
