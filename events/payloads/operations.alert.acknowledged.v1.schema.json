{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/operations.alert.acknowledged.v1.schema.json",
  "title": "OperationsAlertAcknowledgedPayload",
  "description": "Payload of `operations.alert.acknowledged` version 1: a platform member acknowledged an alert by name; it stops repeating while it stays open. The envelope's `partner_id` is `null`. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "alert_id",
    "key",
    "by",
    "at"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid",
      "description": "The alert.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c0008"
      ]
    },
    "key": {
      "type": "string",
      "description": "The definition and its subject.",
      "examples": [
        "objective_burn_page:assignment"
      ]
    },
    "by": {
      "type": "string",
      "format": "uuid",
      "description": "The platform member who acted.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c000d"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the platform recorded it.",
      "examples": [
        "2026-10-22T10:10:00Z"
      ]
    }
  }
}
