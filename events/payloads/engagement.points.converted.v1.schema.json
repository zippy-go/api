{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/engagement.points.converted.v1.schema.json",
  "title": "EngagementPointsConvertedPayload",
  "description": "Payload of `engagement.points.converted` version 1. A customer converted points into promotional Wallet credit, the oldest first; the ledger moves their liability into the Wallet. Consumers: the ledger, analytics.",
  "type": "object",
  "required": [
    "conversion_id",
    "customer_id",
    "points",
    "credit",
    "lots",
    "at"
  ],
  "properties": {
    "conversion_id": {
      "type": "string",
      "format": "uuid",
      "description": "The conversion.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d8101"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "points": {
      "type": "integer",
      "description": "Points converted.",
      "examples": [
        600
      ],
      "minimum": 500
    },
    "credit": {
      "type": "object",
      "description": "The credit given.",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "examples": [
        {
          "minor_units": 6000,
          "currency": "INR"
        }
      ]
    },
    "lots": {
      "type": "array",
      "description": "The lots it drew on, with how many points each.",
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "points",
          "funder",
          "partner_id"
        ],
        "properties": {
          "lot_id": {
            "type": "string",
            "format": "uuid",
            "description": "The lot.",
            "examples": [
              "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d8401"
            ]
          },
          "points": {
            "type": "integer",
            "description": "Points drawn.",
            "examples": [
              600
            ],
            "minimum": 1
          },
          "funder": {
            "type": "string",
            "description": "Its funder.",
            "examples": [
              "partner"
            ],
            "enum": [
              "partner",
              "platform"
            ]
          },
          "partner_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Its Partner.",
            "examples": [
              null
            ]
          }
        }
      },
      "examples": [
        [
          {
            "lot_id": "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d8401",
            "points": 600,
            "funder": "platform",
            "partner_id": null
          }
        ]
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-03T14:20:00Z"
      ]
    }
  }
}
