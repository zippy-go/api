{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/fleet.document.rejected.v1.schema.json",
  "title": "FleetDocumentRejectedPayload",
  "description": "Payload of `fleet.document.rejected` version 1. A reviewer rejected a document with a reason the Agent reads; the Agent is told and may file it again. The envelope's `partner_id` is the Agent's Partner. No payload carries a phone number, an email address or a document number. Read it at `GET /v1/partners/{partner_id}/agents/{agent_id}/documents`. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "document_id",
    "agent_id",
    "partner_id",
    "service_id",
    "user_id",
    "kind",
    "status",
    "by",
    "at",
    "reason"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "The document.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9e01"
      ]
    },
    "agent_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Agent membership.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a10"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Partner; the envelope's `partner_id` too.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a02"
      ]
    },
    "service_id": {
      "type": "string",
      "format": "uuid",
      "description": "The delivery service.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a45"
      ]
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Agent's person.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "identity",
        "driving_licence",
        "vehicle_registration",
        "police_verification"
      ],
      "description": "What the document is.",
      "examples": [
        "driving_licence"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "under_review",
        "approved",
        "rejected",
        "expired"
      ],
      "description": "Where it stands after the change.",
      "examples": [
        "under_review"
      ]
    },
    "by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Who filed or decided it.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-10-16T09:00:00Z"
      ]
    },
    "reason": {
      "type": "string",
      "description": "The reviewer's reason.",
      "examples": [
        "Unreadable, please upload a clearer photo"
      ]
    }
  }
}
