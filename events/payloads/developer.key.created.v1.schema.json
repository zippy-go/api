{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/developer.key.created.v1.schema.json",
  "title": "DeveloperKeyCreatedPayload",
  "description": "Payload of `developer.key.created` version 1. An API key was created. Consumers: the sandbox (a Partner's first sandbox key makes its twin), notifications (the Partner's owners told), analytics. No payload carries a key, a secret, a name of a person, a phone number or an email. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "key_id",
    "partner_id",
    "environment",
    "scopes",
    "by",
    "at"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "format": "uuid",
      "description": "The key.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b7c01"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "Its Partner; the envelope's `partner_id` too.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a02"
      ]
    },
    "environment": {
      "type": "string",
      "description": "`sandbox` or `production`.",
      "examples": [
        "sandbox"
      ],
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Its scopes.",
      "examples": [
        [
          "orders:read",
          "orders:write"
        ]
      ]
    },
    "by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Who created it (a user id).",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a10"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-02T10:15:00Z"
      ]
    }
  },
  "additionalProperties": true
}
