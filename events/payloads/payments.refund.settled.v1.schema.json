{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payments.refund.settled.v1.schema.json",
  "title": "PaymentsRefundSettledPayload",
  "description": "Payload of `payments.refund.settled` version 1. Consumers must ignore fields they do not know.",
  "type": "object",
  "required": [
    "refund_id",
    "payment_id",
    "purpose",
    "order_id",
    "customer_id",
    "partner_id",
    "outcome",
    "to_source",
    "to_wallet",
    "provider_reference"
  ],
  "properties": {
    "refund_id": {
      "type": "string",
      "format": "uuid",
      "description": "The refund."
    },
    "payment_id": {
      "type": "string",
      "format": "uuid",
      "description": "The payment it gives back."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "order",
        "wallet_top_up"
      ],
      "description": "An order's payment or a Wallet top-up."
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The order, for an order's payment."
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer."
    },
    "partner_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The order's Partner."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "moved_to_wallet",
        "switched_to_wallet"
      ],
      "description": "How it ended."
    },
    "to_source": {
      "$ref": "#/$defs/money",
      "description": "What reached the original payment."
    },
    "to_wallet": {
      "$ref": "#/$defs/money",
      "description": "What went to the Wallet's paid balance instead."
    },
    "provider_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "The provider's reference of the refund."
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
