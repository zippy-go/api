{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payouts.statement.locked.v1.schema.json",
  "title": "PayoutsStatementLockedPayload",
  "description": "Payload of `payouts.statement.locked` version 1. A week was locked into its statement, once, by the clock on the Tuesday after it or by platform staff once it was over: its figures never change after. The ledger settles the week from it: the GST the invoice bills beyond the orders' own, the cancellation fees, fee credits, adjustments and the cash the Location or the Agent kept, and an Agent's pay and tips into what the Agent is owed. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "payee_kind",
    "partner_id",
    "location_id",
    "agent_id",
    "statement_id",
    "reference",
    "week",
    "state",
    "previous_state",
    "version",
    "currency",
    "at",
    "locked_by",
    "starts_on",
    "ends_on",
    "time_zone",
    "figures",
    "invoice",
    "credit_note_numbers",
    "gst_difference"
  ],
  "properties": {
    "payee_kind": {
      "type": "string",
      "description": "Whom the statement pays: a Location, or a platform fleet Agent.",
      "examples": [
        "location"
      ],
      "enum": [
        "location",
        "agent"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner, or the Agent's; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Location, for a Location's statement; `null` for an Agent's.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Agent membership, for an Agent's statement; `null` for a Location's.",
      "examples": [
        null
      ]
    },
    "statement_id": {
      "type": "string",
      "format": "uuid",
      "description": "The statement.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c5101"
      ]
    },
    "reference": {
      "type": "string",
      "description": "Its reference, `ZG-{year}W{week}` for a Location or `AG-{year}W{week}` for an Agent.",
      "examples": [
        "ZG-2026W43"
      ]
    },
    "week": {
      "type": "string",
      "description": "The ISO week, `YYYYWww`.",
      "examples": [
        "2026W43"
      ],
      "pattern": "^[0-9]{4}W[0-9]{2}$"
    },
    "state": {
      "type": "string",
      "description": "The state after the change.",
      "examples": [
        "due"
      ],
      "enum": [
        "due",
        "sending",
        "paid",
        "unpaid",
        "archived"
      ]
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "due",
        "sending",
        "paid",
        "unpaid",
        "archived",
        null
      ],
      "description": "The state before; `null` for the lock.",
      "examples": [
        null
      ]
    },
    "version": {
      "type": "integer",
      "description": "The statement's version after the change; it only rises.",
      "examples": [
        1
      ],
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "description": "The currency.",
      "examples": [
        "INR"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the platform recorded it.",
      "examples": [
        "2026-10-27T00:15:00Z"
      ]
    },
    "locked_by": {
      "type": "string",
      "description": "Who locked it: the `clock`, or `staff`.",
      "examples": [
        "clock"
      ],
      "enum": [
        "clock",
        "staff"
      ]
    },
    "starts_on": {
      "type": "string",
      "format": "date",
      "description": "The week's Monday.",
      "examples": [
        "2026-10-19"
      ]
    },
    "ends_on": {
      "type": "string",
      "format": "date",
      "description": "The week's Sunday.",
      "examples": [
        "2026-10-25"
      ]
    },
    "time_zone": {
      "type": "string",
      "description": "The payee's clock.",
      "examples": [
        "Asia/Kolkata"
      ]
    },
    "figures": {
      "type": "object",
      "description": "The week's figures, every amount present, zero where it does not apply.",
      "required": [
        "sales",
        "fee",
        "fee_gst",
        "cancellation_fees",
        "cancellation_fees_gst",
        "fee_credits",
        "fee_credits_gst",
        "delivery_charges",
        "tips",
        "cutlery_charges",
        "refunds",
        "cash_collected",
        "pay",
        "cash_kept",
        "adjustments",
        "carried_in",
        "total",
        "payable",
        "carried_out"
      ],
      "properties": {
        "sales": {
          "$ref": "#/$defs/money",
          "description": "Item sales of a Location's orders."
        },
        "fee": {
          "$ref": "#/$defs/money",
          "description": "The platform's fee."
        },
        "fee_gst": {
          "$ref": "#/$defs/money",
          "description": "GST on the fee, as the invoice bills it."
        },
        "cancellation_fees": {
          "$ref": "#/$defs/money",
          "description": "Fees on orders the Partner cancelled after the customer paid."
        },
        "cancellation_fees_gst": {
          "$ref": "#/$defs/money",
          "description": "GST on them, as the invoice bills it."
        },
        "fee_credits": {
          "$ref": "#/$defs/money",
          "description": "Fees credited back by fee corrections, with a credit note."
        },
        "fee_credits_gst": {
          "$ref": "#/$defs/money",
          "description": "GST credited back with them."
        },
        "delivery_charges": {
          "$ref": "#/$defs/money",
          "description": "Delivery charges that are the Location's, for its own Agents."
        },
        "tips": {
          "$ref": "#/$defs/money",
          "description": "Tips: a Location's own Agents' to pass on, or a platform fleet Agent's in full."
        },
        "cutlery_charges": {
          "$ref": "#/$defs/money",
          "description": "Cutlery charges."
        },
        "refunds": {
          "$ref": "#/$defs/money",
          "description": "Refunds charged to the Partner."
        },
        "cash_collected": {
          "$ref": "#/$defs/money",
          "description": "Cash the Location collected itself."
        },
        "pay": {
          "$ref": "#/$defs/money",
          "description": "A platform fleet Agent's pay for the week's tasks, tips not included."
        },
        "cash_kept": {
          "$ref": "#/$defs/money",
          "description": "Cash a platform fleet Agent collected and kept instead of depositing."
        },
        "adjustments": {
          "$ref": "#/$defs/money",
          "description": "Adjustments settled into the week, fee corrections not included: positive adds, negative takes off."
        },
        "carried_in": {
          "$ref": "#/$defs/money",
          "description": "What the week before carried in; a shortfall is negative."
        },
        "total": {
          "$ref": "#/$defs/money",
          "description": "The week's total."
        },
        "payable": {
          "$ref": "#/$defs/money",
          "description": "What is paid."
        },
        "carried_out": {
          "$ref": "#/$defs/money",
          "description": "A shortfall carried to the next statement, negative; zero otherwise."
        }
      },
      "additionalProperties": false
    },
    "invoice": {
      "type": [
        "object",
        "null"
      ],
      "description": "The GST invoice for the platform's fee; `null` for a week with no fee and for an Agent's statement.",
      "required": [
        "number",
        "taxable_value",
        "cgst",
        "sgst",
        "igst",
        "total"
      ],
      "properties": {
        "number": {
          "type": "string",
          "description": "The invoice number.",
          "examples": [
            "INV-2026-00017"
          ]
        },
        "taxable_value": {
          "$ref": "#/$defs/money",
          "description": "The fees together."
        },
        "cgst": {
          "$ref": "#/$defs/money",
          "description": "Central GST."
        },
        "sgst": {
          "$ref": "#/$defs/money",
          "description": "State GST."
        },
        "igst": {
          "$ref": "#/$defs/money",
          "description": "Integrated GST."
        },
        "total": {
          "$ref": "#/$defs/money",
          "description": "The fees and their GST, deducted from the payout."
        }
      },
      "additionalProperties": false
    },
    "credit_note_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The credit notes the lock issued.",
      "examples": [
        []
      ]
    },
    "gst_difference": {
      "$ref": "#/$defs/money",
      "description": "The GST the invoice bills less the GST the orders were split with, which the lock posts; negative when the invoice bills less."
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
