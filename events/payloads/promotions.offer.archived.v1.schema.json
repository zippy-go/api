{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/promotions.offer.archived.v1.schema.json",
  "title": "PromotionsOfferArchivedPayload",
  "description": "Payload of `promotions.offer.archived` version 1. An ended or cancelled offer was moved out of its owner's lists. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "offer_id",
    "owner",
    "partner_id",
    "kind",
    "purpose",
    "mechanic",
    "state",
    "previous_state",
    "location_ids",
    "partner_share_percent",
    "actor",
    "reason",
    "at"
  ],
  "properties": {
    "offer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The offer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d6001"
      ]
    },
    "owner": {
      "type": "string",
      "description": "Whose it is.",
      "examples": [
        "partner"
      ],
      "enum": [
        "partner",
        "platform"
      ]
    },
    "partner_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The owning Partner; `null` for the platform's; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "kind": {
      "type": "string",
      "description": "What it was made as.",
      "examples": [
        "partner_offer"
      ],
      "enum": [
        "partner_offer",
        "campaign",
        "store_promotion"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ],
      "description": "A platform campaign's purpose.",
      "examples": [
        null
      ],
      "enum": [
        "first_order",
        "referral",
        null
      ]
    },
    "mechanic": {
      "type": "string",
      "description": "Its mechanic.",
      "examples": [
        "multibuy"
      ],
      "enum": [
        "basket_off",
        "free_delivery",
        "items_off",
        "multibuy",
        "n_for_price",
        "bundle",
        "free_item",
        "stamp_card"
      ]
    },
    "state": {
      "type": "string",
      "description": "Its state after.",
      "examples": [
        "live"
      ],
      "enum": [
        "draft",
        "scheduled",
        "live",
        "paused",
        "ended",
        "cancelled"
      ]
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its state before; `null` when it was made.",
      "examples": [
        "scheduled"
      ],
      "enum": [
        "draft",
        "scheduled",
        "live",
        "paused",
        "ended",
        "cancelled",
        null
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "The Locations it names; empty for a campaign aimed wider, resolved at each pricing.",
      "examples": [
        [
          "01a13a48-9e00-7000-8000-000000000301"
        ]
      ]
    },
    "partner_share_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "The Partners' share of its cost.",
      "examples": [
        100
      ]
    },
    "actor": {
      "type": "string",
      "description": "Who moved it: the Partner, the platform or the clock.",
      "examples": [
        "clock"
      ],
      "enum": [
        "partner",
        "platform",
        "clock"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "The reason given, such as a platform pause's.",
      "examples": [
        null
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-06T10:30:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
