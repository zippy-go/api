{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/ordering.tab.round_recalled.v1.schema.json",
  "title": "OrderingTabRoundRecalledPayload",
  "description": "Payload of `ordering.tab.round_recalled` version 1. A member recalled a round before anything of it was fired: it leaves the display and the bill. Consumers: the kitchen (the ticket withdrawn). Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "tab_id",
    "number",
    "partner_id",
    "location_id",
    "table_id",
    "table_name",
    "state",
    "version",
    "at",
    "round_id",
    "round_number"
  ],
  "properties": {
    "tab_id": {
      "type": "string",
      "format": "uuid",
      "description": "The tab, which is the order's id.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d0201"
      ]
    },
    "number": {
      "type": "string",
      "description": "The order's number.",
      "examples": [
        "AB0042"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "table_id": {
      "type": "string",
      "format": "uuid",
      "description": "The table it is on.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d0101"
      ]
    },
    "table_name": {
      "type": "string",
      "description": "The table's name.",
      "examples": [
        "12"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "bill_presented",
        "settled",
        "closed_unpaid",
        "cancelled"
      ],
      "description": "The tab's state after the change.",
      "examples": [
        "open"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "The tab's version after the change.",
      "examples": [
        2
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-11-06T14:31:00Z"
      ]
    },
    "round_id": {
      "type": "string",
      "format": "uuid",
      "description": "The round.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d0301"
      ]
    },
    "round_number": {
      "type": "integer",
      "minimum": 0,
      "description": "Its number.",
      "examples": [
        2
      ]
    }
  }
}
