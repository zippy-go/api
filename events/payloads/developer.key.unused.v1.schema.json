{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/developer.key.unused.v1.schema.json",
  "title": "DeveloperKeyUnusedPayload",
  "description": "Payload of `developer.key.unused` version 1. A key has not been used for 180 days; it is flagged, never revoked. Consumers: notifications (its owners told), analytics. No payload carries a key, a secret, a name of a person, a phone number or an email. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "key_id",
    "partner_id",
    "environment",
    "last_used_at",
    "at"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "format": "uuid",
      "description": "The key.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b7c01"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "Its Partner; the envelope's `partner_id` too.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a02"
      ]
    },
    "environment": {
      "type": "string",
      "description": "`sandbox` or `production`.",
      "examples": [
        "sandbox"
      ],
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When it was last used; `null` if never.",
      "examples": [
        null
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-02T10:15:00Z"
      ]
    }
  },
  "additionalProperties": true
}
