{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payouts.question.asked.v1.schema.json",
  "title": "PayoutsQuestionAskedPayload",
  "description": "Payload of `payouts.question.asked` version 1. A Location or an Agent asked about a locked week, \"Something look wrong?\"; Mission Control lists it on the week's statement. The words stay on the platform. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "payee_kind",
    "partner_id",
    "location_id",
    "agent_id",
    "question_id",
    "statement_id",
    "reference",
    "week",
    "at"
  ],
  "properties": {
    "payee_kind": {
      "type": "string",
      "description": "Whom the statement pays: a Location, or a platform fleet Agent.",
      "examples": [
        "location"
      ],
      "enum": [
        "location",
        "agent"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner, or the Agent's; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Location, for a Location's statement; `null` for an Agent's.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Agent membership, for an Agent's statement; `null` for a Location's.",
      "examples": [
        null
      ]
    },
    "question_id": {
      "type": "string",
      "format": "uuid",
      "description": "The question.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c5301"
      ]
    },
    "statement_id": {
      "type": "string",
      "format": "uuid",
      "description": "The statement.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c5101"
      ]
    },
    "reference": {
      "type": "string",
      "description": "Its reference.",
      "examples": [
        "ZG-2026W43"
      ]
    },
    "week": {
      "type": "string",
      "description": "The week.",
      "examples": [
        "2026W43"
      ],
      "pattern": "^[0-9]{4}W[0-9]{2}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-10-28T06:00:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
