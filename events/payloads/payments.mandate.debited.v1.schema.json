{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payments.mandate.debited.v1.schema.json",
  "title": "PaymentsMandateDebitedPayload",
  "description": "Payload of `payments.mandate.debited` version 1. A delivery day's debit was taken and landed in the customer's Wallet as paid money, from which the day is held at the cutoff; the ledger posts it from the provider's clearing to the Wallet. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "mandate_id",
    "debit_id",
    "customer_id",
    "subscription_id",
    "date",
    "amount",
    "attempt",
    "wallet_entry_id",
    "provider_reference",
    "at"
  ],
  "properties": {
    "mandate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The mandate.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7601"
      ]
    },
    "debit_id": {
      "type": "string",
      "format": "uuid",
      "description": "The delivery day's debit.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7701"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "subscription_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The subscription it pays.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The delivery day it pays for.",
      "examples": [
        "2026-11-06"
      ]
    },
    "amount": {
      "$ref": "#/$defs/money",
      "description": "What it took, into the Wallet."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "1 at 09:00 the day before, 2 at 15:00.",
      "examples": [
        1
      ]
    },
    "wallet_entry_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Wallet's entry it landed as.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7901"
      ]
    },
    "provider_reference": {
      "type": "string",
      "description": "The provider's reference of the debit.",
      "examples": [
        "simdbt_0192b6f49b0a7cde8f3a6d2c1e4c7701_1"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-05T03:30:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
