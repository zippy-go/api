{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/customers.export.ready.v1.schema.json",
  "title": "CustomersExportReadyPayload",
  "description": "Payload of `customers.export.ready` version 1. A customer's export is ready to download for seven days. Consumers: notifications (the customer told). Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "export_id",
    "user_id",
    "requested_by",
    "expires_at",
    "at"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "format": "uuid",
      "description": "The export.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9f01"
      ]
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9c01"
      ]
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "customer",
        "support"
      ],
      "description": "Who asked.",
      "examples": [
        "customer"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Until when.",
      "examples": [
        "2026-11-10T10:15:00Z"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-02T10:15:00Z"
      ]
    }
  },
  "additionalProperties": true
}
