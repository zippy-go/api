{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/ordering.order.placed.v1.schema.json",
  "title": "OrderingOrderPlacedPayload",
  "description": "Payload of `ordering.order.placed` version 1. An order was placed: paid, held, or with nothing to take now (cash); the store hears it. Consumers: notifications (the customer, the store's new order with its sound), the ledger and payments. The envelope's `partner_id` is the store's Partner and its `correlation_id` follows the order. Read the order at `GET /v1/platform/orders/{order_id}`, `GET /v1/customer/orders/{order_id}` or the store's route. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "order_id",
    "number",
    "location_id",
    "partner_id",
    "customer_id",
    "status",
    "previous_status",
    "version",
    "fulfilment",
    "currency",
    "at",
    "placed_at",
    "accept_by",
    "subtotal",
    "delivery_fee",
    "small_order_fee",
    "cutlery_fee",
    "tip",
    "total",
    "tax_included",
    "payment_method",
    "payment_state",
    "wallet_amount",
    "method_amount",
    "carrier"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid",
      "description": "The order.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01"
      ]
    },
    "number": {
      "type": "string",
      "description": "The order's number, as said aloud.",
      "examples": [
        "AB0042"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer (a user id); fetch personal data from the API when it is needed.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "paying",
        "placed",
        "accepted",
        "ready",
        "on_its_way",
        "completed",
        "undelivered",
        "declined",
        "cancelled",
        "expired"
      ],
      "description": "The status after the change.",
      "examples": [
        "placed"
      ]
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "paying",
        "placed",
        "accepted",
        "ready",
        "on_its_way",
        "completed",
        "undelivered",
        "declined",
        "cancelled",
        "expired",
        null
      ],
      "description": "The status before; `null` for a first status.",
      "examples": [
        "paying"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "The order's version after the change; it only rises, and signals carry it.",
      "examples": [
        2
      ]
    },
    "fulfilment": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "description": "Delivery or pickup.",
      "examples": [
        "delivery"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "The currency of every amount, in its minor unit.",
      "examples": [
        "INR"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-10-16T13:00:00Z"
      ]
    },
    "placed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was placed.",
      "examples": [
        "2026-10-16T13:00:00Z"
      ]
    },
    "accept_by": {
      "type": "string",
      "format": "date-time",
      "description": "When it is declined as not answered unless the store accepts.",
      "examples": [
        "2026-10-16T13:30:00Z"
      ]
    },
    "subtotal": {
      "type": "integer",
      "description": "The lines.",
      "examples": [
        73800
      ]
    },
    "delivery_fee": {
      "type": "integer",
      "description": "The delivery fee; 0 for a pickup.",
      "examples": [
        4000
      ]
    },
    "small_order_fee": {
      "type": "integer",
      "description": "The small-order fee.",
      "examples": [
        0
      ]
    },
    "cutlery_fee": {
      "type": "integer",
      "description": "The cutlery fee.",
      "examples": [
        0
      ]
    },
    "tip": {
      "type": "integer",
      "description": "The tip.",
      "examples": [
        2000
      ]
    },
    "total": {
      "type": "integer",
      "description": "The total, tax included.",
      "examples": [
        79800
      ]
    },
    "tax_included": {
      "type": "integer",
      "description": "The GST the total includes.",
      "examples": [
        4124
      ]
    },
    "payment_method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "upi",
        "card",
        "cash",
        null
      ],
      "description": "The method paying what the Wallet does not.",
      "examples": [
        "upi"
      ]
    },
    "payment_state": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "authorised",
        "captured",
        "failed",
        "released",
        "refunded"
      ],
      "description": "How the payment stands.",
      "examples": [
        "captured"
      ]
    },
    "wallet_amount": {
      "type": "integer",
      "description": "What the Wallet pays.",
      "examples": [
        0
      ]
    },
    "method_amount": {
      "type": "integer",
      "description": "What the method pays.",
      "examples": [
        79800
      ]
    },
    "carrier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "own_agents",
        "platform_fleet",
        "external_carrier",
        null
      ],
      "description": "Who carries a delivery, as the store offered it when the order was placed; `null` for a pickup.",
      "examples": [
        "platform_fleet"
      ]
    },
    "discounts": {
      "type": "integer",
      "description": "What the platform's offers took off the items and the basket, in minor units.",
      "examples": [
        42900
      ]
    },
    "delivery_discount": {
      "type": "integer",
      "description": "The delivery fee free delivery waived, in minor units.",
      "examples": [
        0
      ]
    },
    "offers": {
      "type": "array",
      "description": "The offers the order was placed with, each with its cost split, in minor units; the ledger posts the platform's share as a promotions expense and takes the Partner's off what it is owed.",
      "items": {
        "type": "object",
        "description": "An offer on the order.",
        "required": [
          "offer_id",
          "redemption_id",
          "owner",
          "kind",
          "saving",
          "partner_cost",
          "platform_cost"
        ],
        "properties": {
          "offer_id": {
            "type": "string",
            "format": "uuid",
            "description": "The offer."
          },
          "redemption_id": {
            "type": "string",
            "format": "uuid",
            "description": "Its use."
          },
          "owner": {
            "type": "string",
            "enum": [
              "partner",
              "platform"
            ],
            "description": "The offer's owner."
          },
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "basket",
              "delivery",
              "free_item"
            ],
            "description": "What it took off."
          },
          "code_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The code it came through."
          },
          "saving": {
            "type": "integer",
            "description": "What it took off."
          },
          "partner_cost": {
            "type": "integer",
            "description": "The Partner's share."
          },
          "platform_cost": {
            "type": "integer",
            "description": "The platform's share."
          }
        }
      },
      "examples": [
        []
      ]
    },
    "slot": {
      "type": [
        "object",
        "null"
      ],
      "description": "The slot a scheduled order or a subscription's occurrence is placed into: for a delivery the window it arrives in, for a pickup the window it is ready in; `null` for an order for now. Since 0.24.0.",
      "required": [
        "starts_at",
        "ends_at"
      ],
      "additionalProperties": false,
      "properties": {
        "starts_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the window starts.",
          "examples": [
            "2026-11-06T00:30:00Z"
          ]
        },
        "ends_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it ends.",
          "examples": [
            "2026-11-06T02:30:00Z"
          ]
        }
      },
      "examples": [
        {
          "starts_at": "2026-11-06T00:30:00Z",
          "ends_at": "2026-11-06T02:30:00Z"
        }
      ]
    },
    "occurrence": {
      "type": [
        "object",
        "null"
      ],
      "description": "The subscription an order was generated for at the cutoff, and its delivery day; `null` for any other order. Since 0.24.0.",
      "required": [
        "subscription_id",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "subscription_id": {
          "type": "string",
          "format": "uuid",
          "description": "The subscription.",
          "examples": [
            "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
          ]
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The delivery day.",
          "examples": [
            "2026-11-06"
          ]
        }
      },
      "examples": [
        {
          "subscription_id": "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201",
          "date": "2026-11-06"
        }
      ]
    },
    "shared_trip": {
      "type": [
        "object",
        "null"
      ],
      "description": "The order this one shares a trip with, and the delivery fee waived on this one, paid by ZippyGo (minor units); `null` when it shares none. Since 0.25.0.",
      "required": [
        "order_id",
        "waived"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid",
          "description": "The order it rides with.",
          "examples": [
            "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01"
          ]
        },
        "waived": {
          "type": "integer",
          "minimum": 0,
          "description": "The fee waived, in minor units.",
          "examples": [
            4000
          ]
        }
      },
      "examples": [
        {
          "order_id": "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01",
          "waived": 4000
        }
      ]
    }
  }
}
