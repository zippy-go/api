{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/kitchen.course.flagged.v1.schema.json",
  "title": "KitchenCourseFlaggedPayload",
  "description": "Payload of `kitchen.course.flagged` version 1. A held course has waited too long. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "ticket_id",
    "partner_id",
    "location_id",
    "source",
    "order_id",
    "tab_id",
    "round_id",
    "at",
    "course",
    "table_id",
    "table_name",
    "waiting_since"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "format": "uuid",
      "description": "The ticket."
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner; the envelope's `partner_id` too."
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location."
    },
    "source": {
      "type": "string",
      "description": "What the ticket came from: `order` or `round`.",
      "enum": [
        "order",
        "round"
      ]
    },
    "order_id": {
      "type": "string",
      "format": "uuid",
      "description": "The order, which for a round is the tab."
    },
    "tab_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The tab of a round; `null` for a delivery or a pickup."
    },
    "round_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The round; `null` for a delivery or a pickup."
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened: for a mark, the moment it was made."
    },
    "course": {
      "type": "string",
      "enum": [
        "starters",
        "mains",
        "desserts",
        "drinks",
        "none"
      ],
      "description": "The course held."
    },
    "table_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The table of a round."
    },
    "table_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its name."
    },
    "waiting_since": {
      "type": "string",
      "format": "date-time",
      "description": "When the course before it was ready."
    }
  }
}
