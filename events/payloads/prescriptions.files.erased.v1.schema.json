{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/prescriptions.files.erased.v1.schema.json",
  "title": "PrescriptionsFilesErasedPayload",
  "description": "Payload of `prescriptions.files.erased` version 1. An order's prescription files were deleted and its names blanked: thirty days after the order ended, or at once when the customer erased their account. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "partner_id",
    "location_id",
    "order_id",
    "files",
    "reason",
    "at"
  ],
  "properties": {
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Partner; the envelope's `partner_id` too."
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The pharmacy Location."
    },
    "order_id": {
      "type": "string",
      "format": "uuid",
      "description": "The order."
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "description": "How many files were deleted."
    },
    "reason": {
      "type": "string",
      "enum": [
        "thirty_days",
        "customer_erased"
      ],
      "description": "Why now."
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When."
    }
  }
}
