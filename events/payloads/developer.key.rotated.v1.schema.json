{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/developer.key.rotated.v1.schema.json",
  "title": "DeveloperKeyRotatedPayload",
  "description": "Payload of `developer.key.rotated` version 1. A key was rotated: its successor made and the old key kept until `grace_until`. Consumers: notifications, analytics. No payload carries a key, a secret, a name of a person, a phone number or an email. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "key_id",
    "partner_id",
    "environment",
    "successor_key_id",
    "grace_until",
    "by",
    "at"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "format": "uuid",
      "description": "The key.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b7c01"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "Its Partner; the envelope's `partner_id` too.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a02"
      ]
    },
    "environment": {
      "type": "string",
      "description": "`sandbox` or `production`.",
      "examples": [
        "sandbox"
      ],
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "successor_key_id": {
      "type": "string",
      "format": "uuid",
      "description": "The successor.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b7c02"
      ]
    },
    "grace_until": {
      "type": "string",
      "format": "date-time",
      "description": "Until when the old key works.",
      "examples": [
        "2026-11-03T10:15:00Z"
      ]
    },
    "by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Who rotated it.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a10"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-02T10:15:00Z"
      ]
    }
  },
  "additionalProperties": true
}
