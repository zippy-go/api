{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/ledger.entry.posted.v1.schema.json",
  "title": "LedgerEntryPostedPayload",
  "description": "Payload of `ledger.entry.posted` version 1. Consumers must ignore fields they do not know.",
  "type": "object",
  "required": [
    "entry_id",
    "kind",
    "currency",
    "order_id",
    "payment_id",
    "refund_id",
    "customer_id",
    "partner_id",
    "source_event_id",
    "postings"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "format": "uuid",
      "description": "The entry."
    },
    "kind": {
      "type": "string",
      "enum": [
        "payment_captured",
        "card_held",
        "card_hold_released",
        "order_split",
        "order_split_reversed",
        "refund_issued",
        "refund_to_wallet",
        "wallet_credit",
        "wallet_correction"
      ],
      "description": "What it records."
    },
    "currency": {
      "type": "string",
      "description": "The currency of every posting.",
      "pattern": "^[A-Z]{3}$"
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The order."
    },
    "payment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The payment."
    },
    "refund_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The refund."
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The customer."
    },
    "partner_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Partner."
    },
    "source_event_id": {
      "type": "string",
      "format": "uuid",
      "description": "The event it was posted from."
    },
    "postings": {
      "type": "array",
      "minItems": 2,
      "description": "The postings, debits first.",
      "items": {
        "type": "object",
        "description": "A posting.",
        "required": [
          "account_code",
          "side",
          "amount"
        ],
        "properties": {
          "account_code": {
            "type": "string",
            "description": "The account's code."
          },
          "side": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ],
            "description": "Debit or credit."
          },
          "amount": {
            "$ref": "#/$defs/money",
            "description": "The amount, positive."
          }
        }
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
