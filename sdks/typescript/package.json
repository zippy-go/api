{
  "name": "@zippy-go/api",
  "version": "0.11.0",
  "description": "TypeScript SDK for the ZippyGo API, generated from the OpenAPI document",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zippy-go/api.git",
    "directory": "sdks/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
