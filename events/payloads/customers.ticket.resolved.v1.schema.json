{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/customers.ticket.resolved.v1.schema.json",
  "title": "CustomersTicketResolvedPayload",
  "description": "Payload of `customers.ticket.resolved` version 1. A ticket was resolved. Consumers: analytics.",
  "type": "object",
  "required": [
    "ticket_id",
    "customer_id",
    "by_user_id",
    "opened_at",
    "at"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "format": "uuid",
      "description": "The ticket.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7001"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "by_user_id": {
      "type": "string",
      "format": "uuid",
      "description": "The member.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000101"
      ]
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it opened, for how long it took.",
      "examples": [
        "2026-11-04T09:40:00Z"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-04T10:15:00Z"
      ]
    }
  }
}
