{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/subscriptions.subscription.paused.v1.schema.json",
  "title": "SubscriptionsSubscriptionPausedPayload",
  "description": "Payload of `subscriptions.subscription.paused` version 1. A subscription paused: by the customer, or by itself for want of balance, after three failed deliveries in 14 days, or because its mandate was revoked. Consumers: notifications (the customer when it paused itself, with how to resume), the store's calendar, analytics. No payload carries a name, a phone number, an email or an address. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "subscription_id",
    "customer_id",
    "partner_id",
    "location_id",
    "plan_id",
    "state",
    "previous_state",
    "frequency",
    "starts_on",
    "ends_on",
    "pay_by",
    "price_per_delivery",
    "at",
    "from",
    "until",
    "reason"
  ],
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid",
      "description": "The subscription.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer (a user id); fetch personal data from the API when it is needed.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000006"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000307"
      ]
    },
    "plan_id": {
      "type": "string",
      "format": "uuid",
      "description": "The plan.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7001"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "paused",
        "cancelled",
        "ended"
      ],
      "description": "The subscription's state after the change.",
      "examples": [
        "active"
      ]
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pending",
        "active",
        "paused",
        "cancelled",
        "ended",
        null
      ],
      "description": "Its state before; `null` for a first state.",
      "examples": [
        "pending"
      ]
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekdays",
        "weekends",
        "alternate_days",
        "weekly",
        "custom"
      ],
      "description": "How often it delivers.",
      "examples": [
        "weekdays"
      ]
    },
    "starts_on": {
      "type": "string",
      "format": "date",
      "description": "Its first day.",
      "examples": [
        "2026-11-07"
      ]
    },
    "ends_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Its last day; `null` while open-ended.",
      "examples": [
        null
      ]
    },
    "pay_by": {
      "type": "string",
      "enum": [
        "wallet",
        "mandate"
      ],
      "description": "How it pays.",
      "examples": [
        "wallet"
      ]
    },
    "price_per_delivery": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "A delivery at the everyday quantities, the fee included.",
      "examples": [
        {
          "minor_units": 6400,
          "currency": "INR"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-11-05T16:30:00Z"
      ]
    },
    "from": {
      "type": "string",
      "format": "date",
      "description": "The first day without deliveries.",
      "examples": [
        "2026-11-03"
      ]
    },
    "until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "The last day without them; `null` until resumed.",
      "examples": [
        null
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "customer",
        "balance",
        "failed_deliveries",
        "mandate_revoked"
      ],
      "description": "Why.",
      "examples": [
        "customer"
      ]
    }
  }
}
