{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/wallet.entry.recorded.v1.schema.json",
  "title": "WalletEntryRecordedPayload",
  "description": "Payload of `wallet.entry.recorded` version 1. Never carries the reason's note. Consumers must ignore fields they do not know.",
  "type": "object",
  "required": [
    "entry_id",
    "customer_id",
    "kind",
    "balance",
    "amount",
    "held",
    "balance_after",
    "held_after",
    "order_id",
    "payment_id",
    "refund_id",
    "payer",
    "payer_partner_id",
    "wallet_version"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "format": "uuid",
      "description": "The entry."
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer."
    },
    "kind": {
      "type": "string",
      "enum": [
        "top_up",
        "credit",
        "refund",
        "hold",
        "spend",
        "release",
        "withdrawal",
        "correction"
      ],
      "description": "What changed the Wallet."
    },
    "balance": {
      "type": "string",
      "enum": [
        "paid",
        "promotional"
      ],
      "description": "The balance it touched."
    },
    "amount": {
      "$ref": "#/$defs/money",
      "description": "What it added to the balance, negative when it took away."
    },
    "held": {
      "$ref": "#/$defs/money",
      "description": "What it added to the held amount, negative when a hold was spent or released."
    },
    "balance_after": {
      "$ref": "#/$defs/money",
      "description": "The balance after it."
    },
    "held_after": {
      "$ref": "#/$defs/money",
      "description": "The held amount after it."
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The order it belongs to."
    },
    "payment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The payment it belongs to."
    },
    "refund_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The refund it came from."
    },
    "payer": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "platform",
        "partner",
        null
      ],
      "description": "Who pays for a credit."
    },
    "payer_partner_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The Partner, when a Partner pays for a credit."
    },
    "wallet_version": {
      "type": "integer",
      "description": "The Wallet's version after it.",
      "minimum": 1
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
