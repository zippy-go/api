{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/crosssell.codelivery.formed.v1.schema.json",
  "title": "CrosssellCodeliveryFormedPayload",
  "description": "Payload of `crosssell.codelivery.formed` version 1. Two orders of one customer from two Partners travel on one trip: placed within 15 minutes, to one address, from stores within 1 km. Each stays its own order. The envelope names no Partner. Consumers: analytics. No payload carries a name, a phone number, an email or an address. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "customer_id",
    "trip_id",
    "order_ids",
    "location_ids",
    "partner_ids",
    "at"
  ],
  "properties": {
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "trip_id": {
      "type": "string",
      "format": "uuid",
      "description": "The trip.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c8201"
      ]
    },
    "order_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "The two orders, the first placed first.",
      "examples": [
        [
          "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b01",
          "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9b02"
        ]
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Their stores.",
      "examples": [
        [
          "01a13a48-9e00-7000-8000-000000000301",
          "01a13a48-9e00-7000-8000-000000000308"
        ]
      ]
    },
    "partner_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Their Partners.",
      "examples": [
        [
          "01a13a48-9e00-7000-8000-000000000001",
          "01a13a48-9e00-7000-8000-000000000003"
        ]
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the second joined the trip.",
      "examples": [
        "2026-11-06T07:12:00Z"
      ]
    }
  }
}
