{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payments.mandate.notified.v1.schema.json",
  "title": "PaymentsMandateNotifiedPayload",
  "description": "Payload of `payments.mandate.notified` version 1. The pre-debit notice of a delivery day's debit went to the customer, at 08:00 two days before the delivery and at least 24 hours before the debit. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "mandate_id",
    "customer_id",
    "subscription_id",
    "date",
    "amount",
    "debit_at",
    "at"
  ],
  "properties": {
    "mandate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The mandate.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7601"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "subscription_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The subscription it pays.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The delivery day the debit pays for.",
      "examples": [
        "2026-11-06"
      ]
    },
    "amount": {
      "$ref": "#/$defs/money",
      "description": "What the debit will take."
    },
    "debit_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the debit will be asked: 09:00 the day before the delivery.",
      "examples": [
        "2026-11-05T03:30:00Z"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the notice went.",
      "examples": [
        "2026-11-04T02:30:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
