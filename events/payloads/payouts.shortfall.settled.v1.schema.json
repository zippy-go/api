{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/payouts.shortfall.settled.v1.schema.json",
  "title": "PayoutsShortfallSettledPayload",
  "description": "Payload of `payouts.shortfall.settled` version 1. A shortfall was paid: the carry is cleared. Consumers: the ledger (the money into the Partner's payable), analytics.",
  "type": "object",
  "required": [
    "shortfall_id",
    "statement_id",
    "partner_id",
    "location_id",
    "amount",
    "payment_id",
    "at"
  ],
  "properties": {
    "shortfall_id": {
      "type": "string",
      "format": "uuid",
      "description": "The shortfall.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7201"
      ]
    },
    "statement_id": {
      "type": "string",
      "format": "uuid",
      "description": "The statement.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7301"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Partner.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "amount": {
      "type": "object",
      "description": "What was paid.",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "examples": [
        {
          "minor_units": 540000,
          "currency": "INR"
        }
      ]
    },
    "payment_id": {
      "type": "string",
      "format": "uuid",
      "description": "The payment.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4e7401"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-05T10:00:00Z"
      ]
    }
  }
}
