{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/crosssell.recommendation.shown.v1.schema.json",
  "title": "CrosssellRecommendationShownPayload",
  "description": "Payload of `crosssell.recommendation.shown` version 1: a recommendation was shown, with its kind and its reason, so analytics measures acceptance. The envelope's `partner_id` is `null`, so no Partner reads which customers were shown its items; the customer appears by id alone, and not at all for a visitor. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "recommendation_id",
    "kind",
    "reason",
    "location_id",
    "item_id",
    "term_id",
    "customer_id",
    "shown_with",
    "shown_at"
  ],
  "properties": {
    "recommendation_id": {
      "type": "string",
      "format": "uuid",
      "description": "The recommendation.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4bf001"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "bought_together",
        "nearby_complement",
        "reorder"
      ],
      "description": "Why it was suggested.",
      "examples": [
        "nearby_complement"
      ]
    },
    "reason": {
      "type": "string",
      "description": "The reason as shown.",
      "examples": [
        "Nearby, goes with your order"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store of the item suggested.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a48"
      ]
    },
    "item_id": {
      "type": "string",
      "format": "uuid",
      "description": "The item suggested.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4bc301"
      ]
    },
    "term_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The item's term.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4bd201"
      ]
    },
    "customer_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The customer, by id alone; `null` for a visitor.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9c01"
      ]
    },
    "shown_with": {
      "type": "object",
      "description": "What it was shown beside: the order it goes with, or the store and items it was asked for.",
      "required": [
        "order_id",
        "location_id"
      ],
      "properties": {
        "order_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The order, for a nearby complement.",
          "examples": [
            "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9d01"
          ]
        },
        "location_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The store whose page or basket asked, for bought together; the order's store for a complement.",
          "examples": [
            "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a40"
          ]
        }
      },
      "examples": [
        {
          "order_id": "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9d01",
          "location_id": "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a40"
        }
      ]
    },
    "shown_at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-10-29T09:00:00Z"
      ]
    }
  }
}
