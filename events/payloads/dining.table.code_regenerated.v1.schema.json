{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/dining.table.code_regenerated.v1.schema.json",
  "title": "DiningTableCodeRegeneratedPayload",
  "description": "Payload of `dining.table.code_regenerated` version 1. A table's code was regenerated: sheets printed before stop opening tabs. The code itself is not carried. Consumers: the floor. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "table_id",
    "partner_id",
    "location_id",
    "name",
    "seats",
    "area",
    "service",
    "version",
    "at"
  ],
  "properties": {
    "table_id": {
      "type": "string",
      "format": "uuid",
      "description": "The table.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d0101"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "name": {
      "type": "string",
      "description": "Its name.",
      "examples": [
        "12"
      ]
    },
    "seats": {
      "type": "integer",
      "minimum": 0,
      "description": "Its seats.",
      "examples": [
        4
      ]
    },
    "area": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its area.",
      "examples": [
        null
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "order",
        "pay_only"
      ],
      "description": "How it is served.",
      "examples": [
        "order"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "Its version after the change.",
      "examples": [
        1
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-11-06T14:31:00Z"
      ]
    }
  }
}
