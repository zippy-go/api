{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/crosssell.bundle.published.v1.schema.json",
  "title": "CrosssellBundlePublishedPayload",
  "description": "Payload of `crosssell.bundle.published` version 1. Mission Control published a bundle across two Partners: each side's offer is made for the promotions engine and each store is invited to accept. The envelope names no Partner. Consumers: notifications (each store's invitation), analytics. No payload carries a name, a phone number, an email or an address. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "bundle_id",
    "state",
    "location_ids",
    "partner_ids",
    "saving",
    "funded_by",
    "at"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "format": "uuid",
      "description": "The bundle.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c8401"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "live",
        "declined",
        "stopped"
      ],
      "description": "Its state after the change.",
      "examples": [
        "published"
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Its two stores, the first side first.",
      "examples": [
        [
          "01a13a48-9e00-7000-8000-000000000301",
          "01a13a48-9e00-7000-8000-000000000308"
        ]
      ]
    },
    "partner_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Their Partners.",
      "examples": [
        [
          "01a13a48-9e00-7000-8000-000000000001",
          "01a13a48-9e00-7000-8000-000000000003"
        ]
      ]
    },
    "saving": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "The saving on the pair.",
      "examples": [
        {
          "minor_units": 6000,
          "currency": "INR"
        }
      ]
    },
    "funded_by": {
      "type": "string",
      "enum": [
        "platform",
        "partners"
      ],
      "description": "Who pays the saving.",
      "examples": [
        "platform"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened.",
      "examples": [
        "2026-11-01T09:30:00Z"
      ]
    }
  }
}
