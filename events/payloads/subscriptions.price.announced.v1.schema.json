{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/subscriptions.price.announced.v1.schema.json",
  "title": "SubscriptionsPriceAnnouncedPayload",
  "description": "Payload of `subscriptions.price.announced` version 1. A plan item's new price was announced to one subscriber: it applies from seven days after, and deliveries until then keep the old price. Consumers: notifications (the customer, with the old price, the new price and the day). Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "subscription_id",
    "customer_id",
    "partner_id",
    "location_id",
    "plan_id",
    "item_id",
    "variant_id",
    "old_price",
    "new_price",
    "applies_from",
    "at"
  ],
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid",
      "description": "The subscription.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store's Partner.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000006"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000307"
      ]
    },
    "plan_id": {
      "type": "string",
      "format": "uuid",
      "description": "The plan.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7001"
      ]
    },
    "item_id": {
      "type": "string",
      "format": "uuid",
      "description": "The item.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7101"
      ]
    },
    "variant_id": {
      "type": "string",
      "format": "uuid",
      "description": "The variant.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7102"
      ]
    },
    "old_price": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "The price of one until then.",
      "examples": [
        {
          "minor_units": 3200,
          "currency": "INR"
        }
      ]
    },
    "new_price": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "The price of one from then.",
      "examples": [
        {
          "minor_units": 3400,
          "currency": "INR"
        }
      ]
    },
    "applies_from": {
      "type": "string",
      "format": "date",
      "description": "The first delivery day at the new price.",
      "examples": [
        "2026-11-08"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was announced.",
      "examples": [
        "2026-11-01T06:00:00Z"
      ]
    }
  }
}
