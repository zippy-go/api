{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/tenancy.document.notice_sent.v1.schema.json",
  "title": "TenancyDocumentNoticeSentPayload",
  "description": "Payload of `tenancy.document.notice_sent` version 1: a notice about a document's expiry or rejection went to the partner's contacts, once per step. Never the recipients' addresses. The envelope's `partner_id` is the partner. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "partner_id",
    "document_id",
    "kind",
    "step",
    "recipients"
  ],
  "properties": {
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The partner, the same value as the envelope's `partner_id`.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a02"
      ]
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "The document.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a50"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "gst_registration",
        "fssai_licence",
        "shop_establishment",
        "pan",
        "identity",
        "bank_proof",
        "other"
      ],
      "description": "Its kind.",
      "examples": [
        "gst_registration"
      ]
    },
    "step": {
      "type": "string",
      "enum": [
        "expires_in_30_days",
        "expires_in_7_days",
        "expires_today",
        "grace_ended",
        "rejected"
      ],
      "description": "Which notice.",
      "examples": [
        "expires_in_30_days"
      ]
    },
    "recipients": {
      "type": "integer",
      "minimum": 0,
      "description": "How many contacts it reached; never their addresses.",
      "examples": [
        2
      ]
    }
  }
}
