{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/promotions.participation.declined.v1.schema.json",
  "title": "PromotionsParticipationDeclinedPayload",
  "description": "Payload of `promotions.participation.declined` version 1. A Location declined a campaign, an invitation or one the platform pays for in full: it stops applying there at once; orders already placed keep it. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "offer_id",
    "partner_id",
    "location_id",
    "status",
    "partner_share_percent",
    "by_user_id",
    "at"
  ],
  "properties": {
    "offer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The campaign.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4d6002"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location's Partner; the envelope's `partner_id` too.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000001"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The Location.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000301"
      ]
    },
    "status": {
      "type": "string",
      "description": "The answer, or `invited`.",
      "examples": [
        "accepted"
      ],
      "enum": [
        "invited",
        "accepted",
        "declined"
      ]
    },
    "partner_share_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "The Partner's share of the campaign's cost.",
      "examples": [
        50
      ]
    },
    "by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Who answered; `null` for an invitation.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a05"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-11-06T10:30:00Z"
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units with its ISO 4217 currency.",
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in the currency's minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency, upper case."
        }
      },
      "additionalProperties": false
    }
  }
}
