{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/subscriptions.statement.ready.v1.schema.json",
  "title": "SubscriptionsStatementReadyPayload",
  "description": "Payload of `subscriptions.statement.ready` version 1. A subscription's statement for a month was issued, on the 1st of the next month at 08:00 on the store's clock. Consumers: notifications (the customer: in the account, and by email where they have one). Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "subscription_id",
    "customer_id",
    "partner_id",
    "location_id",
    "month",
    "delivered",
    "delivered_amount",
    "skipped",
    "failed",
    "closing_balance",
    "at"
  ],
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid",
      "description": "The subscription.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4c7201"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer.",
      "examples": [
        "0192b6f4-9b0a-7cde-8f3a-6d2c1e4b9a70"
      ]
    },
    "partner_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store's Partner.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000006"
      ]
    },
    "location_id": {
      "type": "string",
      "format": "uuid",
      "description": "The store.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000307"
      ]
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "The month, YYYY-MM.",
      "examples": [
        "2026-11"
      ]
    },
    "delivered": {
      "type": "integer",
      "minimum": 0,
      "description": "Days delivered.",
      "examples": [
        26
      ]
    },
    "delivered_amount": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "What they cost.",
      "examples": [
        {
          "minor_units": 166400,
          "currency": "INR"
        }
      ]
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "description": "Days skipped, paused, away, closed or unpaid.",
      "examples": [
        4
      ]
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "description": "Days that could not be delivered.",
      "examples": [
        1
      ]
    },
    "closing_balance": {
      "type": "object",
      "required": [
        "minor_units",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minor_units": {
          "type": "integer",
          "description": "The amount in paise."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The ISO 4217 code."
        }
      },
      "description": "The Wallet at the month's end.",
      "examples": [
        {
          "minor_units": 23600,
          "currency": "INR"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When.",
      "examples": [
        "2026-12-01T02:30:00Z"
      ]
    }
  }
}
