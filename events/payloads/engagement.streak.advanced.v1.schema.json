{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zippy-go/api/main/events/payloads/engagement.streak.advanced.v1.schema.json",
  "title": "EngagementStreakAdvancedPayload",
  "description": "Payload of `engagement.streak.advanced` version 1: a customer's weekly streak counted a week with a completed order. The envelope's `partner_id` is the campaign's Partner, `null` for the platform's. Consumers must ignore fields they do not know; new optional fields are an additive change.",
  "type": "object",
  "required": [
    "campaign_id",
    "customer_id",
    "week",
    "weeks",
    "at",
    "previous_weeks",
    "milestone"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "format": "uuid",
      "description": "The streak campaign.",
      "examples": [
        "01a13a48-9e00-7000-8000-000000006001"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid",
      "description": "The customer (a user id).",
      "examples": [
        "01a13a48-9e00-7000-8000-000000000701"
      ]
    },
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}W[0-9]{2}$",
      "description": "The week, Monday to Sunday on the clock of its Locations.",
      "examples": [
        "2026W45"
      ]
    },
    "weeks": {
      "type": "integer",
      "description": "Weeks in a row after it.",
      "minimum": 0,
      "examples": [
        4
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the platform recorded it.",
      "examples": [
        "2026-11-04T12:00:00Z"
      ]
    },
    "previous_weeks": {
      "type": "integer",
      "description": "Weeks in a row before it.",
      "minimum": 0,
      "examples": [
        3
      ]
    },
    "milestone": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The milestone it reached, in weeks; `null` when none.",
      "examples": [
        4
      ]
    }
  }
}
